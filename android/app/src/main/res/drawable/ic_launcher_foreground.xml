<?xml version="1.0" encoding="utf-8"?>
<!--
  Das Zeichen der Operation.

  Ein Fadenkreuz mit einem X darin: Zielperson und Fahndung in einem Bild. Als
  Vektor, damit es auf jeder Bildschirmdichte scharf bleibt, und ohne Bilddatei,
  damit die App-Datei nicht wächst — sie wird am Spieltag über Mobilfunk
  geladen.

  Bis hierher hatte die App gar kein Symbol und stand auf dem Startbildschirm
  als grüner Android-Roboter zwischen den anderen Anwendungen. Wer sie in der
  Eile sucht, findet sie so nicht.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Fadenkreuzring -->
    <path
        android:strokeColor="#D9A441"
        android:strokeWidth="3.5"
        android:fillColor="#00000000"
        android:pathData="M54,26 A28,28 0 1,1 53.9,26" />

    <!-- Marken an den vier Seiten -->
    <path
        android:strokeColor="#D9A441"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M54,18 L54,26 M54,82 L54,90 M18,54 L26,54 M82,54 L90,54" />

    <!-- Das X -->
    <path
        android:strokeColor="#FF5C47"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M43,43 L65,65 M65,43 L43,65" />
</vector>
